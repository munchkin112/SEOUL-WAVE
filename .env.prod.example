# Copy to .env.prod on the EC2 host and replace every placeholder. Never commit .env.prod.
# Backend image already verified by CI. Tags are raw 40-character commit SHAs.
BACKEND_IMAGE=909345918351.dkr.ecr.ap-northeast-2.amazonaws.com/seoulwave:0a662217736ca2f9f348d1806080cdaad87d531d
# WAIT: replace only after the Kakao-key-enabled frontend build has published its SHA-tagged image.
FRONTEND_IMAGE=909345918351.dkr.ecr.ap-northeast-2.amazonaws.com/seoul-wave-frontend:WAIT_FOR_KEY_ENABLED_BUILD_SHA

# Copy these four values exactly from the existing production database/container and volume.
# Do not generate a new password or use development defaults. Do not deploy while placeholders remain.
POSTGRES_VOLUME_NAME=COPY_EXISTING_PRODUCTION_VOLUME_NAME_UNCHANGED
POSTGRES_DB=COPY_EXISTING_PRODUCTION_DATABASE_NAME_UNCHANGED
POSTGRES_USER=COPY_EXISTING_PRODUCTION_DATABASE_USER_UNCHANGED
POSTGRES_PASSWORD=COPY_EXISTING_PRODUCTION_DATABASE_PASSWORD_UNCHANGED

# Required production application settings.
APP_ENV=production
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
SITE_ACCESS_PASSWORDS=REPLACE_WITH_OPERATOR_PASSWORDS
SESSION_COOKIE_SECURE=true
SEOUL_CULTURE_API_KEY=REPLACE_WITH_SEOUL_OPEN_DATA_API_KEY
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=REPLACE_WITH_APPROVED_MODEL
# Optional; the application accepts empty and defaults radius to 5 km.
FERRY_STOP_COORDINATES_JSON=
EVENT_DESTINATION_RADIUS_KM=5

# Frontend only host exposure. Bind address can be restricted to a host interface.
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=80
