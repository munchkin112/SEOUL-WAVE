# Seoul Open Data Plaza cultural-events API general authentication key.
# Copy this file to .env and set the key locally. Do not commit .env.
SEOUL_CULTURE_API_KEY=

# PostgreSQL for local Compose development.
POSTGRES_DB=
POSTGRES_USER=
# Set your local DB password in .env. Do not commit the real password.
POSTGRES_PASSWORD=

# Site access gate. Keep actual values in the ignored root .env file.
APP_ENV=development
SESSION_SECRET=
SITE_ACCESS_PASSWORDS=
SESSION_COOKIE_SECURE=false
